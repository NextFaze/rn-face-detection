{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "rnfacedetection"
  ],
  "ios": {
    "iosModuleName": "NitroRnFaceDetection"
  },
  "android": {
    "androidNamespace": [
      "rnfacedetection"
    ],
    "androidCxxLibName": "NitroRnFaceDetection"
  },
  "autolinking": {
    "FaceDetection": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFaceDetection"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
